{
  "expo": {
    "name": "Koino",
    "slug": "koino-mobile",
    "version": "1.0.0",
    "icon": "./assets/images/icon.png",
    "orientation": "portrait",
    "scheme": "koinomobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.koino.mobile",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.koino.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-google-signin/google-signin",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#E88A00",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Koino to select photos you choose to share in the community and private conversations."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Koino to access photos you choose.",
          "savePhotosPermission": "Allow Koino to save chat images to your photo library.",
          "granularPermissions": [
            "photo"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3c6a1254-3aae-4515-ba23-512b65977c3e"
      }
    },
    "owner": "jedyv"
  }
}
