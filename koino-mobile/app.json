{
  "expo": {
    "name": "koino-mobile",
    "slug": "koino-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "koinomobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.koino.mobile"
    },
    "android": {
      "package": "com.koino.mobile",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
